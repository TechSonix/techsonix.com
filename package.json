{
  "name": "techsonix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && node scripts/check-export.mjs",
    "preview": "python3 -m http.server 3005 --bind 127.0.0.1 --directory out",
    "deploy": "npm run build && node scripts/check-export.mjs && gh-pages -d out --dotfiles",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests docs README.md .github"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.17",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.35",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
